generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // o "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model City {
  id   String @id @default(cuid())
  name String  @unique
  @@index([name])
}

model Route {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  cityId    String          // FK lógica a City
  desc      String?
  @@index([cityId])
  @@index([code])
  @@index([name])
}

model Stop {
  id       String  @id @default(cuid())
  routeId  String  // FK lógica a Route
  orderNo  Int
  name     String
  lat      Float?
  lng      Float?
  @@index([routeId])
  @@index([orderNo])
}

model Schedule {
  id           String @id @default(cuid())
  routeId      String // FK lógica a Route
  dayOfWeek    Int    // 0..6  (Dom..Sáb)
  startTime    String // "05:00"
  endTime      String // "22:00"
  frequencyMin Int    // cada n minutos
  @@index([routeId])
  @@index([dayOfWeek])
}

model Feedback {
  id        String   @id @default(cuid())
  routeId   String   // FK lógica a Route
  title     String
  body      String?
  createdAt DateTime @default(now())
  createdBy String?  // userId o texto libre
  @@index([routeId])
  @@index([createdAt])
}
